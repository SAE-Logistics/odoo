<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_move_form_inherit_cost_centre" model="ir.ui.view">
        <field name="name">account.move.form.inherit.cost.centre</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id'][1]" position="after">
                <label for="cost_centre_id" string="Cost Centre"/>
                <field name="cost_centre_id"
                       domain="[('partner_id', '=', commercial_partner_id)]"
                       readonly="state != 'draft'"
                       invisible="move_type not in ('out_invoice', 'out_refund')"/>
            </xpath>
        </field>
    </record>

    <record id="view_out_invoice_tree_inherit_cost_centre" model="ir.ui.view">
        <field name="name">account.move.out.invoice.list.inherit.cost.centre</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_invoice_tree"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='invoice_partner_display_name'][last()]" position="after">
                <field name="cost_centre_id" optional="show"/>
            </xpath>
        </field>
    </record>
</odoo>
