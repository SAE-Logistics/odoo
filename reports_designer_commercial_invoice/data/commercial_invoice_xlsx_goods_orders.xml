  <!-- Commercial Invoice (XLSX) - Goods Orders variant, run at Delivery Order (stock.picking) level -->
  <!-- Derived from commercial_invoice_xlsx.xml (account.move original). Field mapping: -->
  <!--   name -> name, invoice_date -> scheduled_date, partner_shipping_id.* -> partner_id.* -->
  <!--   amount_total -> sale_id.amount_total, invoice_line_ids -> move_ids (model stock.move) -->
  <!--   quantity -> product_uom_qty, product_uom_id -> product_uom, price_subtotal -> sale_line_id.price_subtotal -->
