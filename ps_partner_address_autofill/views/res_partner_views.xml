<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_partner_form_street_placeholder" model="ir.ui.view">
        <field name="name">res.partner.form.street.placeholder</field>
        <field name="model">res.partner</field>
        <field name="inherit_id" ref="base.view_partner_form"/>
        <field name="arch" type="xml">

            <!-- Only `street` gets the search box; it fills street2/city/zip/
                 state/country too, so a second box would be a duplicate.
                 First match in document order is the top-level address block. -->
            <xpath expr="//field[@name='street']" position="attributes">
                <attribute name="widget">google_places_autocomplete</attribute>
            </xpath>

            <!-- Same box in the "Create Contact" dialog: the child_ids inline
                 form subview under the Contacts & Addresses tab. -->
            <xpath expr="//field[@name='child_ids']/form//field[@name='street']"
                   position="attributes">
                <attribute name="widget">google_places_autocomplete</attribute>
            </xpath>

        </field>
    </record>
</odoo>

