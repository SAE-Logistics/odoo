<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_stock_quant_tree_inherit_container_count" model="ir.ui.view">
        <field name="name">stock.quant.tree.inherit.container.count</field>
        <field name="model">stock.quant</field>
        <field name="inherit_id" ref="stock.view_stock_quant_tree_simple"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='package_id']" position="attributes">
                <attribute name="column_invisible">True</attribute>
                <attribute name="optional">hide</attribute>
            </xpath>
            <xpath expr="//field[@name='quantity']" position="after">
                <field name="container_count" string="No. of Containers" sum="Total Containers"/>
            </xpath>
        </field>
    </record>

