<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!--
        Shared page header/footer for the Transport and Warehouse invoice PDFs.

        Odoo/wkhtmltopdf repeats <div class="header"> and <div class="footer">
        on every page, which is how the company header, the payment/legal
        footer and "Page X of Y" appear on every page of a multi-page invoice.

        Footer text lives in Settings > Companies > (company) > Document footer
        (company.report_footer) so SAE can change it without a code deploy.
        The lines below are only used when that field is empty.
    -->
    <template id="invoice_report_page_header">
        <div class="header">
            <style>
                .inv-hdr { width: 100%; border-collapse: collapse; border: 0; font-family: Arial, sans-serif; }
                .inv-hdr td { vertical-align: top; padding: 0; border: 0; }
                .inv-hdr .inv-logo { max-height: 70px; max-width: 230px; }
                .inv-hdr .inv-company { text-align: right; color: #63749b; font-size: 11px; line-height: 1.3; }
                .inv-hdr .inv-website { color: #79a64b; font-size: 14px; font-weight: bold; }
            </style>
            <table class="inv-hdr">
                <tr>
                    <td style="width: 48%;">
                        <img t-if="company.logo"
                             t-att-src="image_data_uri(company.logo)"
                             class="inv-logo"
                             alt="Company Logo"/>
                    </td>
                    <td style="width: 52%;" class="inv-company">
                        <div><span t-esc="company.street or ''"/></div>
                        <div t-if="company.street2"><span t-esc="company.street2"/></div>
                        <div>
                            <span t-esc="company.city or ''"/>
                            <t t-if="company.city and company.state_id">, </t>
                            <span t-esc="company.state_id.name if company.state_id else ''"/>
                            <t t-if="company.zip">, </t><span t-esc="company.zip or ''"/>
                        </div>
                        <div t-if="company.phone"><strong>T:</strong> <span t-esc="company.phone"/></div>
                        <div t-if="company.email"><strong>E:</strong> <span t-esc="company.email"/></div>
                        <div class="inv-website" t-if="company.website">
                            <span t-esc="company.website.replace('http://', '').replace('https://', '')"/>
                        </div>
                    </td>
                </tr>
            </table>
        </div>
    </template>

    <template id="invoice_report_page_footer">
        <div class="footer">
            <style>
                .inv-ftr { font-family: Arial, sans-serif; border-top: 1px solid #d9deea; padding-top: 5px;
                           color: #333; font-size: 8.5px; line-height: 1.35; }
                .inv-ftr .inv-page { text-align: right; color: #8eb979; font-size: 9px; }
            </style>
            <div class="inv-ftr">
                <div t-if="company.report_footer" t-out="company.report_footer"/>
                <t t-else="">
                    <div>
                        <strong t-esc="company.name"/>
                        <t t-if="company.company_registry"> Company Reg no: <span t-esc="company.company_registry"/></t>
                        <t t-if="company.vat"> VAT: <span t-esc="company.vat"/></t>
                    </div>
                    <div t-if="company.partner_id.bank_ids">
                        <strong>Payment details:</strong>
                        <span t-esc="company.partner_id.bank_ids[0].bank_id.name or ''"/>
                        <t t-if="company.partner_id.bank_ids[0].acc_number"> Account no: <span t-esc="company.partner_id.bank_ids[0].acc_number"/></t>
                    </div>
                </t>
                <div class="inv-page">(Page <span class="page"/> of <span class="topage"/>)</div>
            </div>
        </div>
    </template>
</odoo>
