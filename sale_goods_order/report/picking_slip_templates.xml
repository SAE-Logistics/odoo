<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Picking Operations (stock.picking) customisation: the picking note the
        warehouse works from.

        1. Title block: "PICKING SLIP" and the order number printed large; the
           picking reference (WH/OUT/xxxxx) is the small secondary line. The
           barcode of the picking name is kept (scanning) on the right.
        2. Footer: the company footer (bank / payment details) is removed for
           this report only. Page number stays. Done with the same scope flag
           mechanism as the Delivery Slip (see delivery_slip_templates.xml):
           `picking_slip_no_footer` is set inside the layout call body and the
           layout footer inherits there skip the company footer when it is set.
        3. Picker completion grid at the end of the document, so it lands at the
           bottom of the final page of a multi-page picking note.
    -->

    <template id="report_picking_sae" inherit_id="stock.report_picking">

        <xpath expr="//t[@t-set='address']" position="before">
            <t t-set="picking_slip_no_footer" t-value="True"/>
            <!-- Same source as the standard Delivery Address block. UK deliveries drop
                 the country line on both addresses (company address in the layout
                 header reads `delivery_slip_uk`, see delivery_slip_templates.xml). -->
            <t t-set="slip_dest" t-value="o.move_ids[:1].partner_id or o.partner_id"/>
            <t t-set="delivery_slip_uk" t-value="slip_dest.country_id.code == 'GB'"/>
        </xpath>

        <!-- Delivery address: UK deliveries print without the country; others keep
             the standard contact widget. -->
        <xpath expr="//div[@t-if='o.should_print_delivery_address()']/div[@t-out]" position="replace">
            <div t-if="delivery_slip_uk" name="slip_uk_address">
                <t t-call="sale_goods_order.delivery_slip_uk_address"/>
            </div>
            <div t-else="" t-out="slip_dest"
                 t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
        </xpath>

        <!-- Customer Address block (outgoing pickings) is redundant next to the
             Delivery Address. Vendor / warehouse blocks for other picking types stay. -->
        <xpath expr="//div[@name='div_incoming_address']/div[contains(@t-elif, 'outgoing')]" position="replace"/>

        <!-- Order notes + delivery instructions, ahead of the item lines -->
        <xpath expr="//table[@t-if='o.move_line_ids and o.move_ids_without_package']" position="before">
            <t t-set="slip_order_note" t-value="o.sale_id.order_note"/>
            <t t-set="slip_deliver_note" t-value="o.sale_id.deliver_note"/>
            <div t-if="slip_order_note or slip_deliver_note" name="slip_notes"
                 style="border:1px solid #666; padding:8px 10px; margin-bottom:14px; page-break-inside:avoid;">
                <div t-if="slip_order_note">
                    <div style="font-weight:bold;">Order Notes</div>
                    <div t-out="slip_order_note" style="white-space:pre-line;"/>
                </div>
                <div t-if="slip_deliver_note" t-att-style="'margin-top:8px;' if slip_order_note else ''">
                    <div style="font-weight:bold;">Delivery Instructions</div>
                    <div t-out="slip_deliver_note" style="white-space:pre-line;"/>
                </div>
            </div>
        </xpath>

        <!-- Title: form name, order number, transfer ref (left); barcode (right) -->
        <xpath expr="//div[hasclass('row') and hasclass('mt16') and hasclass('mb16')]" position="replace">
            <div name="slip_head_row" class="row mt16 mb16">
                <div name="slip_title_col" class="col-7">
                    <div style="font-size:30px; font-weight:bold; letter-spacing:1px; text-transform:uppercase; line-height:1.1;">
                        Picking Slip
                    </div>
                    <div t-if="o.origin" style="font-size:24px; font-weight:bold; margin-top:6px;">
                        Order No: <span t-field="o.origin"/>
                    </div>
                    <div class="text-muted" style="font-size:13px; margin-top:2px;">
                        Transfer: <span t-field="o.name"/>
                    </div>
                </div>
                <div name="slip_barcode_col" class="col-5">
                    <div t-field="o.name" t-options="{'widget': 'barcode', 'width': 600, 'height': 100, 'img_style': 'width:300px;height:50px;'}"/>
                </div>
            </div>
        </xpath>

        <!-- Order number is now in the title; drop the small duplicate -->
        <xpath expr="//div[@name='div_origin']" position="replace"/>

        <!-- Picker completion grid: at the very end, i.e. bottom of the final page -->
        <xpath expr="//p[@t-field='o.note']" position="after">
            <div name="picker_grid" style="margin-top:24px; page-break-inside:avoid;">
                <div style="font-weight:bold; font-size:14px; margin-bottom:6px;">To be completed by picker</div>
                <table style="width:100%; border-collapse:collapse; border:1px solid #666; table-layout:fixed;">
                    <colgroup>
                        <col style="width:17%;"/>
                        <col style="width:33%;"/>
                        <col style="width:17%;"/>
                        <col style="width:33%;"/>
                    </colgroup>
                    <tr style="height:38px;">
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Carton QTY</td>
                        <td style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Pallet QTY</td>
                        <td style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                    </tr>
                    <tr style="height:38px;">
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Databag</td>
                        <td style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Weight</td>
                        <td style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                    </tr>
                    <tr style="height:38px;">
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Dimensions</td>
                        <td colspan="3" style="border:1px solid #666; padding:4px 6px;">
                            Length <span style="display:inline-block; width:80px; border-bottom:1px solid #666;">&#160;</span>
                            &#160; Width <span style="display:inline-block; width:80px; border-bottom:1px solid #666;">&#160;</span>
                            &#160; Height <span style="display:inline-block; width:80px; border-bottom:1px solid #666;">&#160;</span>
                        </td>
                    </tr>
                    <tr style="height:60px;">
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Materials used</td>
                        <td colspan="3" style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                    </tr>
                    <tr style="height:38px;">
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Picker</td>
                        <td style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Time taken</td>
                        <td style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                    </tr>
                    <tr style="height:38px;">
                        <td style="border:1px solid #666; padding:4px 6px; background-color:#eeeeee; font-weight:bold;">Pick date</td>
                        <td colspan="3" style="border:1px solid #666; padding:4px 6px;">&#160;</td>
                    </tr>
                </table>
            </div>
        </xpath>

    </template>

</odoo>
