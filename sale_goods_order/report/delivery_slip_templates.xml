<?xml version="1.0" encoding="utf-8"?>
<odoo>

    <!--
        Delivery Slip (stock.picking) customisation.

        1. Title block: form name ("Delivery Slip") and the order number are
           printed large. The picking reference (e.g. MHB/OUT/00040) drops to
           a smaller secondary line.
        2. Footer: the company footer (company.report_footer) carries the bank
           / payment details and is shared with invoices, so it must NOT be
           edited. The slip sets `delivery_slip_footer` inside the layout call
           body (the same scope mechanism as `address` / `information_block`),
           and the two layout inherits below swap the footer text for the
           company registration line plus the customer-queries wording (italic)
           when that flag is present. Every other document keeps the normal
           company footer.
        3. Layout: Delivery Address on the left, form name / order info on the
           right, so the header block takes less vertical space.
        4. UK deliveries: no country line on either address, and no VAT number
           under the company (From) address.
    -->

    <template id="report_delivery_document_sae" inherit_id="stock.report_delivery_document">

        <!-- Flag read by the layout footer inherits below. -->
        <xpath expr="//t[@t-set='address']" position="before">
            <t t-set="delivery_slip_footer" t-value="True"/>
            <!-- Where the goods are going; same source the standard address block uses.
                 UK deliveries drop the country line (both addresses). -->
            <t t-set="slip_dest" t-value="o.move_ids[:1].partner_id or o.partner_id"/>
            <t t-set="delivery_slip_uk" t-value="slip_dest.country_id.code == 'GB'"/>
        </xpath>

        <!-- Delivery address: for UK deliveries print the lines ourselves, without
             the country. Other countries keep the standard contact widget. -->
        <xpath expr="//div[@name='outgoing_delivery_address']/div[@t-out]" position="replace">
            <div t-if="delivery_slip_uk" name="slip_uk_address">
                <div t-if="slip_dest.name" t-out="slip_dest.name"/>
                <div t-if="slip_dest.street" t-out="slip_dest.street"/>
                <div t-if="slip_dest.street2" t-out="slip_dest.street2"/>
                <div t-if="slip_dest.city" t-out="slip_dest.city"/>
                <div t-if="slip_dest.state_id" t-out="slip_dest.state_id.name"/>
                <div t-if="slip_dest.zip" t-out="slip_dest.zip"/>
                <div t-if="slip_dest.phone"><i class="fa fa-phone fa-fw"/> <span t-out="slip_dest.phone"/></div>
            </div>
            <div t-else="" t-out="slip_dest"
                 t-options="{'widget': 'contact', 'fields': ['address', 'name', 'phone'], 'no_marker': True, 'phone_icons': True}"/>
        </xpath>

        <!-- Two-column row to save vertical space:
             left  = Delivery Address (moved out of the layout's address slot)
             right = form name, order number, transfer ref, shipping date / carrier -->
        <xpath expr="//div[hasclass('page')]/h2" position="replace">
            <div name="slip_head_row" class="row" style="margin-bottom:14px;">
                <div name="slip_address_col" class="col-6"/>
                <div name="slip_title_col" class="col-6">
                    <div style="font-size:30px; font-weight:bold; letter-spacing:1px; text-transform:uppercase; line-height:1.1;">
                        Delivery Slip
                    </div>
                    <div t-if="o.origin" style="font-size:24px; font-weight:bold; margin-top:6px;">
                        Order No: <span t-field="o.origin"/>
                    </div>
                    <div class="text-muted" style="font-size:13px; margin-top:2px; margin-bottom:8px;">
                        Transfer: <span t-field="o.name"/>
                    </div>
                </div>
            </div>
        </xpath>

        <!-- Order number is now in the title; drop the small duplicate -->
        <xpath expr="//div[@name='div_origin']" position="replace"/>

        <!-- Delivery address: from the layout's right-hand address slot to the left column -->
        <xpath expr="//div[@name='slip_address_col']" position="inside">
            <xpath expr="//div[@name='div_outgoing_address']" position="move"/>
        </xpath>

        <!-- Shipping date / carrier: under the title, laid out inline because the
             standard col-3 cells are too narrow inside a half-width column -->
        <xpath expr="//div[@id='informations']" position="attributes">
            <attribute name="class" add="slip-info" separator=" "/>
        </xpath>
        <xpath expr="//div[@name='slip_title_col']" position="inside">
            <style>
                #informations.slip-info { display: block !important; margin-bottom: 0 !important; }
                #informations.slip-info > div { display: inline-block !important; width: auto !important; max-width: none !important; margin-right: 22px; vertical-align: top; }
            </style>
            <xpath expr="//div[@id='informations']" position="move"/>
        </xpath>

    </template>

    <!-- Footer text, bold layout (SAE's configured layout) -->
    <template id="external_layout_bold_delivery_slip_footer"
              inherit_id="web.external_layout_bold">
        <xpath expr="//span[@t-field='company.report_footer']" position="replace">
            <t t-if="delivery_slip_footer">
                <t t-call="sale_goods_order.delivery_slip_footer_text"/>
            </t>
            <span t-else="" t-field="company.report_footer"/>
        </xpath>
    </template>

    <!-- From address (header): on the slip, print it ourselves so the VAT line is
         omitted and the country is dropped for UK deliveries. Original list is
         kept for every other document. -->
    <template id="external_layout_bold_delivery_slip_header"
              inherit_id="web.external_layout_bold"
              priority="20">
        <xpath expr="//ul[@name='company_address_list']" position="attributes">
            <attribute name="t-if">not delivery_slip_footer</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="after">
            <ul t-if="delivery_slip_footer" class="list-unstyled" name="company_address_list_slip">
                <t t-call="sale_goods_order.delivery_slip_company_address"/>
            </ul>
        </xpath>
    </template>

    <template id="external_layout_standard_delivery_slip_header"
              inherit_id="web.external_layout_standard"
              priority="20">
        <xpath expr="//ul[@name='company_address_list']" position="attributes">
            <attribute name="t-if">not delivery_slip_footer</attribute>
        </xpath>
        <xpath expr="//ul[@name='company_address_list']" position="after">
            <ul t-if="delivery_slip_footer" class="list-unstyled" name="company_address_list_slip">
                <t t-call="sale_goods_order.delivery_slip_company_address"/>
            </ul>
        </xpath>
    </template>

    <template id="delivery_slip_company_address">
        <li t-if="company.name" t-out="company.name"/>
        <li t-if="company.street" t-out="company.street"/>
        <li t-if="company.street2" t-out="company.street2"/>
        <li t-if="company.city" t-out="company.city"/>
        <li t-if="company.state_id" t-out="company.state_id.name"/>
        <li t-if="company.zip" t-out="company.zip"/>
        <li t-if="company.country_id and not delivery_slip_uk" t-out="company.country_id.name"/>
    </template>

    <!-- Same swap for the standard layout, in case the company layout is changed -->
    <template id="external_layout_standard_delivery_slip_footer"
              inherit_id="web.external_layout_standard">
        <xpath expr="//div[@t-field='company.report_footer']" position="replace">
            <div t-if="delivery_slip_footer" class="flex-grow-1 text-start me-2">
                <t t-call="sale_goods_order.delivery_slip_footer_text"/>
            </div>
            <div t-else="" class="flex-grow-1 text-start me-2" t-field="company.report_footer"/>
        </xpath>
    </template>

    <template id="delivery_slip_footer_text">
        <div>Security Air Express Ltd T/A SAE Logistics. Company Reg no: 02788444 VAT: GB 626994101</div>
        <div style="font-style:italic; margin-top:3px;">
            Should you have any queries, discrepancies or concerns relating to your delivery,
            please notify SAE Logistics and or your supplier within 24 hours of receipt of the
            goods. This will allow us to investigate and resolve any issues as quickly as
            possible. Any visible damage, shortages or delivery discrepancies should be
            reported within this timeframe.
        </div>
    </template>

</odoo>
