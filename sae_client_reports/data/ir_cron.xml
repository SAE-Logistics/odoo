<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="ir_cron_monthly_cost_breakdown" model="ir.cron">
        <field name="name">SAE: Generate Monthly Cost Breakdown Reports</field>
        <field name="model_id" ref="model_sae_client_report"/>
        <field name="state">code</field>
        <field name="code">model._cron_generate_monthly_cost_breakdown()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">months</field>
        <!-- Reports on the previous month's invoices. Left inactive until the
             first reports have been checked with SAE; then activate it and set
             the next run to a few days into the month so month-end invoices
             are posted first. Late invoices: regenerate from the report. -->
        <field name="active" eval="False"/>
    </record>
</odoo>
