<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sae_client_report_generate_wizard_form" model="ir.ui.view">
        <field name="name">sae.client.report.generate.wizard.form</field>
        <field name="model">sae.client.report.generate.wizard</field>
        <field name="arch" type="xml">
            <form string="Generate Client Reports">
                <group>
                    <field name="month"/>
                    <field name="partner_ids" widget="many2many_tags" placeholder="All clients invoiced in the month"/>
                </group>
                <p class="text-muted">
                    Includes posted invoices and credit notes dated in the chosen month.
                    An existing report for the same client and month is replaced.
                </p>
                <footer>
                    <button name="action_generate" type="object" string="Generate" class="btn-primary"/>
                    <button string="Cancel" special="cancel"/>
                </footer>
            </form>
        </field>
    </record>

    <record id="action_sae_client_report_generate_wizard" model="ir.actions.act_window">
        <field name="name">Generate Client Reports</field>
        <field name="res_model">sae.client.report.generate.wizard</field>
        <field name="view_mode">form</field>
        <field name="target">new</field>
    </record>

    <menuitem id="menu_sae_client_report_generate"
              name="Generate Client Reports"
              action="action_sae_client_report_generate_wizard"
              parent="sale.sale_menu_root"
              sequence="91"/>
</odoo>
