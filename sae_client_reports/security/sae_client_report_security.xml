<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="sae_client_report_portal_rule" model="ir.rule">
        <field name="name">SAE Client Report: portal users see only their own client's reports</field>
        <field name="model_id" ref="model_sae_client_report"/>
        <field name="domain_force">
            [('commercial_partner_id', '=', user.commercial_partner_id.id)]
        </field>
        <field name="groups" eval="[(4, ref('base.group_portal'))]"/>
        <field name="perm_read">1</field>
        <field name="perm_write">0</field>
        <field name="perm_create">0</field>
        <field name="perm_unlink">0</field>
    </record>
</odoo>
