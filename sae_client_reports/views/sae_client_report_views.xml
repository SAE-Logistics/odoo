<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sae_client_report_list" model="ir.ui.view">
        <field name="name">sae.client.report.list</field>
        <field name="model">sae.client.report</field>
        <field name="arch" type="xml">
            <list create="false" decoration-danger="state == 'failed'">
                <field name="commercial_partner_id"/>
                <field name="report_type"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="job_count"/>
                <field name="invoice_count"/>
                <field name="amount_untaxed" sum="Total"/>
                <field name="generated_date"/>
                <field name="state"/>
                <button name="action_download" type="object" icon="fa-download" title="Download"
                        invisible="not attachment_id"/>
                <field name="attachment_id" column_invisible="1"/>
            </list>
        </field>
    </record>

    <record id="view_sae_client_report_form" model="ir.ui.view">
        <field name="name">sae.client.report.form</field>
        <field name="model">sae.client.report</field>
        <field name="arch" type="xml">
            <form create="false">
                <header>
                    <button name="action_regenerate" type="object" string="Regenerate" class="btn-primary"/>
                    <button name="action_download" type="object" string="Download" invisible="not attachment_id"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <group>
                            <field name="commercial_partner_id" readonly="1"/>
                            <field name="report_type" readonly="1"/>
                            <field name="period_start" readonly="1"/>
                            <field name="period_end" readonly="1"/>
                        </group>
                        <group>
                            <field name="job_count" readonly="1"/>
                            <field name="invoice_count" readonly="1"/>
                            <field name="amount_untaxed" readonly="1"/>
                            <field name="generated_date" readonly="1"/>
                            <field name="attachment_id" readonly="1"/>
                        </group>
                    </group>
                    <field name="error_message" readonly="1" invisible="state != 'failed'"/>
                </sheet>
            </form>
        </field>
    </record>

    <record id="view_sae_client_report_search" model="ir.ui.view">
        <field name="name">sae.client.report.search</field>
        <field name="model">sae.client.report</field>
        <field name="arch" type="xml">
            <search>
                <field name="commercial_partner_id"/>
                <filter name="failed" string="Failed" domain="[('state', '=', 'failed')]"/>
                <group expand="0" string="Group By">
                    <filter name="group_period" string="Month" context="{'group_by': 'period_start:month'}"/>
                    <filter name="group_client" string="Client" context="{'group_by': 'commercial_partner_id'}"/>
                </group>
            </search>
        </field>
    </record>

    <record id="action_sae_client_report" model="ir.actions.act_window">
        <field name="name">Client Reports</field>
        <field name="res_model">sae.client.report</field>
        <field name="view_mode">list,form</field>
        <field name="search_view_id" ref="view_sae_client_report_search"/>
    </record>

    <menuitem id="menu_sae_client_report"
              name="Client Reports"
              action="action_sae_client_report"
              parent="sale.sale_menu_root"
              sequence="90"/>
</odoo>
