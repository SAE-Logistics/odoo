<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_sae_client_report_list" model="ir.ui.view">
        <field name="name">sae.client.report.list</field>
        <field name="model">sae.client.report</field>
        <field name="arch" type="xml">
            <list>
                <field name="commercial_partner_id"/>
                <field name="report_type"/>
                <field name="period_start"/>
                <field name="period_end"/>
                <field name="generated_date"/>
                <field name="state"/>
            </list>
        </field>
    </record>

    <record id="action_sae_client_report" model="ir.actions.act_window">
        <field name="name">Client Reports</field>
        <field name="res_model">sae.client.report</field>
        <field name="view_mode">list,form</field>
    </record>

    <menuitem id="menu_sae_client_report"
              name="Client Reports"
              action="action_sae_client_report"
              parent="sale.sale_menu_root"
              sequence="90"/>
</odoo>
