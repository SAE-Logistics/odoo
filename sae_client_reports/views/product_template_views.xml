<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="product_template_form_client_report_group" model="ir.ui.view">
        <field name="name">product.template.form.client.report.group</field>
        <field name="model">product.template</field>
        <field name="inherit_id" ref="product.product_template_form_view"/>
        <field name="arch" type="xml">
            <xpath expr="//group[@name='group_general']" position="inside">
                <field name="client_report_group" invisible="not sale_ok"/>
            </xpath>
        </field>
    </record>
</odoo>
